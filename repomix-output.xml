  .stage-panel { min-height: calc(100vh - 72px); }
  .import-stage { position: relative; overflow: hidden; }
  .import-stage::before { content: ''; position: absolute; inset: 0 52% 0 0; opacity: .42; background-image: repeating-linear-gradient(0deg, transparent 0 31px, rgba(34,75,60,.085) 31px 32px), linear-gradient(90deg, rgba(255,253,248,.5), transparent); pointer-events: none; }
